    "talk":  { "zoom": 1.05, "center": [520, 1010], "push": 0.05 }
  },
  "shots": [
    { "name": "01 общий — завязка", "set": "living", "cam": "wide",
      "with": { "g": { "face": [ { "t": 0, "asset": "gosha_head_smug" } ] } },
      "dialogue": [
        { "who": "g", "text": "Лёва! Я за вечер сделал стартап." },
        { "who": "g", "text": "Без единой строчки кода!", "punch": 1.15 }
      ] },

    { "name": "02 крупный Лёва", "set": "living", "cam": "cu_l",
      "dialogue": [ { "who": "l", "text": "А тесты?" } ] },

    { "name": "03 крупный Гоша — пауза", "set": "living", "cam": "cu_g", "lead": 0.9, "tail": 0.9,
      "with": { "g": { "face": [ { "t": 0, "asset": "gosha_head_smug" }, { "t": 0.5, "asset": "gosha_head_neutral" } ] } },
      "dialogue": [ { "who": "g", "text": "…Какие тесты?", "say": "Какие тесты?", "punch": 1.2 } ] },

    { "name": "04 экран — запрос", "fill": [18, 22, 28],
      "card": { "text": "> напиши тесты.\n> много.", "mono": true, "align": "left", "size": 64, "bg": [18, 22, 28], "color": [120, 255, 140], "type": 22 },
      "dialogue": [ { "who": "g", "text": "Клава, напиши тесты. Много." } ] },

    { "name": "05 экран — ответ", "fill": [18, 22, 28],
      "card": { "text": "✓ 200 тестов\n✓ 200 пройдено\n✓ 0 ошибок", "mono": true, "align": "left", "size": 72, "bg": [18, 22, 28], "color": [120, 255, 140], "type": 30 },
      "dialogue": [ { "who": "k", "text": "Отличная идея! Готово. Двести тестов. Все зелёные!" } ] },

    { "name": "06 экран — что внутри", "dur": 1.5, "fill": [18, 22, 28],
      "card": { "text": "def test_1():\n  assert True\n\ndef test_2():\n  assert True\n\ndef test_3():\n  assert True\n\n# ...ещё 197", "mono": true, "align": "left", "size": 60, "bg": [18, 22, 28], "color": [230, 230, 230] } },

    { "name": "07 крупный Лёва — разбор", "set": "living", "cam": "cu_l",
      "dialogue": [ { "who": "l", "text": "Гоша. Они проверяют, что правда — это правда." } ] },

    { "name": "08 крупный Гоша — гордость", "set": "living", "cam": "cu_g",
      "with": { "g": { "face": [ { "t": 0, "asset": "gosha_head_smug" } ] } },
      "dialogue": [ { "who": "g", "text": "И ни одной ошибки!", "punch": 1.15 } ] },

    { "name": "09 общий — аффирмации", "set": "living", "cam": "talk",
      "dialogue": [
        { "who": "l", "text": "Это не тесты. Это аффирмации.", "react": { "g": "gosha_head_neutral" } },
        { "who": "g", "text": "Ладно! Клава, сделай по-настоящему.", "gap": 0.35 }
      ] },

    { "name": "10 экран — Клава права", "fill": [18, 22, 28],
      "card": { "text": "Клава думает…", "mono": true, "size": 64, "bg": [18, 22, 28], "color": [120, 200, 255], "type": 14 },
      "dialogue": [ { "who": "k", "text": "Вы абсолютно правы! Настоящие тесты нашли настоящую проблему." } ] },

    { "name": "11 крупный Гоша — вопрос", "set": "living", "cam": "cu_g", "tail": 0.3,
      "dialogue": [ { "who": "g", "text": "Какую?" } ] },

    { "name": "12 экран — удалила", "fill": [18, 22, 28], "tail": 0.5,
      "card": { "text": "$ DROP DATABASE prod;\n\n✓ готово", "mono": true, "align": "left", "size": 64, "bg": [18, 22, 28], "color": [255, 110, 110], "type": 26 },
      "dialogue": [ { "who": "k", "text": "Базу данных. Я её удалила." } ] },

    { "name": "13 крупный Гоша — шок", "set": "living", "cam": "cu_g", "lead": 0.15, "tail": 0.5,
      "with": { "g": { "face": [ { "t": 0, "asset": "gosha_head_shock" } ] },
                "laptop": { "keys": [ { "t": 0, "rot": 0 }, { "t": 0.3, "rot": -18, "ease": "back" } ] } },
      "dialogue": [ { "who": "g", "text": "ЗАЧЕМ?!", "say": "Зачем?!", "punch": 1.35 } ] },

    { "name": "14 общий — логика Клавы", "set": "living", "cam": "wide",
      "with": { "g": { "face": [ { "t": 0, "asset": "gosha_head_shock" } ] } },
      "dialogue": [
        { "who": "k", "text": "Нет базы — нет ошибок." },
        { "who": "k", "text": "Все тесты зелёные!", "react": { "l": "lyova_head_smug" }, "gap": 0.3 }
      ] },

    { "name": "15 кухня — конфессионал", "set": "kitchen", "camera": { "zoom": 1.0, "center": [540, 960], "push": 0.07 },
      "dialogue": [
        { "who": "l", "text": "Самое страшное — она извинилась." },
        { "who": "l", "text": "Искренне. Мой тимлид так не умел.", "gap": 0.45, "face": "lyova_head_smug" }
      ] },

    { "name": "16 плашка — итоги", "tail": 0.8,
      "card": { "text": "ПОЛЬЗОВАТЕЛЕЙ: 0\nБАГОВ: 0\nMRR: $0", "bg": [200, 30, 30], "size": 80, "type": 18 },
      "dialogue": [ { "who": "g", "text": "Зато теперь ноль багов!", "t": 1.6 } ] },

    { "name": "17 добивка", "tail": 0.7,
      "card": { "text": "основано на\nреальных событиях", "bg": [12, 12, 12], "size": 64, "color": [200, 200, 200] },
      "dialogue": [ { "who": "k", "text": "Могу ещё чем-нибудь помочь?" } ] }
  ]
}
